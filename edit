        report_file_handle.write(message + "\n") # Single newline for consistency before returning
        # report_file_handle.write("\n\n") # Original double newline for file
        return message # Return the error message

    base_url = "https://www.virustotal.com/api/v3/"
    headers = {"x-apikey": api_key, "User-Agent": "Python Security Scanner Script/1.0"}
    
    is_ip = False
    try:
        ipaddress.ip_address(resource)
        is_ip = True
    except ValueError:
        # Not an IP, assume domain
        pass

    if is_ip:
        url = f"{base_url}ip_addresses/{resource}"
    else:
        url = f"{base_url}domains/{resource}"

    try:
        response = requests.get(url, headers=headers, timeout=20)
        response.raise_for_status()  # Raises HTTPError for bad responses (4XX or 5XX)
        
        data = response.json().get('data', {})
        attributes = data.get('attributes', {})
        
